# Copy this file to .env and fill in your real Neon connection string.
# Get it from your Neon project dashboard -> Connection Details.
# Never commit the real .env file to GitHub.

DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# --- Owner PIN reset (emailed via Gmail) ------------------------------------
# The Gmail account the app sends FROM. Requires 2-Step Verification to be
# enabled on that Google account, then generate an "App Password" at
# https://myaccount.google.com/apppasswords and use it here (NOT your normal
# Gmail password).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16characterapppassword

# The public URL of your GitHub Pages front-end, used to build the reset
# link that gets emailed, e.g. https://YOUR-USERNAME.github.io
APP_URL=https://YOUR-USERNAME.github.io
