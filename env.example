# Copy this file to .env and fill in your real Neon connection string.
# Get it from your Neon project dashboard -> Connection Details.
# Never commit the real .env file to GitHub.

DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# --- Owner PIN reset (emailed via Resend) -----------------------------------
# Sign up free at https://resend.com, verify your email, then create an API
# key at https://resend.com/api-keys.
RESEND_API_KEY=re_your_api_key_here

# Optional: only needed once you've verified your own sending domain on
# Resend. Until then, leave unset and it defaults to Resend's shared test
# sender (onboarding@resend.dev), which only delivers to the email address
# you signed up to Resend with.
# RESEND_FROM=GreenLine Cargo <noreply@yourdomain.com>

# The public URL of your GitHub Pages front-end, used to build the reset
# link that gets emailed, e.g. https://YOUR-USERNAME.github.io/YOUR-REPO
APP_URL=https://YOUR-USERNAME.github.io/YOUR-REPO
